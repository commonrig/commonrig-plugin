{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/helper/helper.mjs\" hook", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/helper/helper.mjs\" hook", "async": true }] }
    ],
    "PreToolUse": [
      { "matcher": "^mcp__.*commonrig.*__start$", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/helper/helper.mjs\" hook", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/helper/helper.mjs\" hook", "async": true }] }
    ]
  }
}
